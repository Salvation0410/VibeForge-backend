AI_SERVICE_INTERNAL_BEARER_TOKEN=replace-with-shared-internal-token
AI_SERVICE_SPRING_GATEWAY_BASE_URL=http://host.docker.internal:8123/api/internal/ai-tools
AI_SERVICE_SPRING_GATEWAY_BEARER_TOKEN=replace-with-gateway-token

# DeepSeek is the default. Any OpenAI-compatible endpoint/model can be used.
AI_SERVICE_MODEL_API_KEY=replace-with-provider-key
AI_SERVICE_MODEL_BASE_URL=https://api.deepseek.com/v1
AI_SERVICE_MODEL_NAME=deepseek-chat
AI_SERVICE_MODEL_TEMPERATURE=0.1
AI_SERVICE_MODEL_MAX_TOKENS=8192

AI_SERVICE_CHECKPOINT_ENABLED=true
AI_SERVICE_CHECKPOINT_REQUIRED=false
AI_SERVICE_CHECKPOINT_POSTGRES_URL=postgresql://yu_ai_checkpoint:replace-with-password@host.docker.internal:5432/yu_ai_checkpoint
AI_SERVICE_CHECKPOINT_AUTO_SETUP=true
AI_SERVICE_CHECKPOINT_TTL_SECONDS=86400
AI_SERVICE_CHECKPOINT_POOL_MIN_SIZE=1
AI_SERVICE_CHECKPOINT_POOL_MAX_SIZE=5
AI_SERVICE_VUE_MAX_TOOL_CALLS=4
AI_SERVICE_MAX_REPAIR_ATTEMPTS=2

# 仅用于 Vue 三角色并行审查，第一阶段默认关闭。
AI_SERVICE_MULTI_AGENT_REVIEW_ENABLED=false
# 三个 Reviewer 共享的整体超时秒数，不是每个 Reviewer 各自的超时。
AI_SERVICE_MULTI_AGENT_REVIEW_TIMEOUT_SECONDS=60

# Customer-service knowledge retrieval stays off until its providers are configured.
AI_SERVICE_CUSTOMER_SERVICE_RAG_ENABLED=false
# In each source, prefixed CloseAI keys take priority over legacy bare keys.
# Process environment takes priority over .env. Uncomment only when setting values.
# AI_SERVICE_CLOSEAI_API_KEY=
# AI_SERVICE_CLOSEAI_BASE_URL=
AI_SERVICE_RAG_EMBEDDING_MODEL=openai:text-embedding-3-large
AI_SERVICE_RAG_EMBEDDING_BATCH_SIZE=32
AI_SERVICE_RAG_MAX_EMBEDDING_ELEMENTS=8000000
AI_SERVICE_RAG_ETL_MAX_CONCURRENCY=2
AI_SERVICE_MILVUS_URI=http://localhost:19530
AI_SERVICE_MILVUS_TOKEN=
AI_SERVICE_MILVUS_DATABASE=default
AI_SERVICE_MILVUS_COLLECTION_ALIAS=customer_service_knowledge
AI_SERVICE_RAG_CHUNK_SIZE=1000
AI_SERVICE_RAG_CHUNK_OVERLAP=150
AI_SERVICE_RAG_RETRIEVAL_TOP_K=8
AI_SERVICE_RAG_FINAL_TOP_K=3
# Leave unset until a real evaluation set establishes a threshold.
# AI_SERVICE_RAG_MIN_RERANK_SCORE=
AI_SERVICE_RAG_RERANKER_PROVIDER=local_cross_encoder
AI_SERVICE_RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
AI_SERVICE_RAG_RERANKER_DEVICE=cuda
AI_SERVICE_RAG_RERANKER_TIMEOUT_SECONDS=5
AI_SERVICE_RAG_RERANKER_BATCH_SIZE=4
AI_SERVICE_RAG_OSS_ALLOWED_HOSTS=
AI_SERVICE_RAG_DOWNLOAD_MAX_BYTES=20971520
AI_SERVICE_RAG_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=5
AI_SERVICE_RAG_DOWNLOAD_READ_TIMEOUT_SECONDS=30

