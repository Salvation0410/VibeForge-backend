AI_SERVICE_INTERNAL_BEARER_TOKEN=replace-with-shared-internal-token
# 默认用于宿主机直接启动；Docker 内连接宿主机时改为 host.docker.internal。
AI_SERVICE_SPRING_GATEWAY_BASE_URL=http://localhost:8123/api/internal/ai-tools
AI_SERVICE_SPRING_GATEWAY_BEARER_TOKEN=replace-with-shared-internal-token

# 默认使用 DeepSeek，也可配置其他 OpenAI 兼容模型；下方占位密钥不能用于真实调用。
AI_SERVICE_MODEL_API_KEY=replace-with-provider-key
AI_SERVICE_MODEL_BASE_URL=https://api.deepseek.com/v1
AI_SERVICE_MODEL_NAME=deepseek-chat
AI_SERVICE_MODEL_TEMPERATURE=0.1
AI_SERVICE_MODEL_MAX_TOKENS=8192

# 输入审核默认开启；故障阻止生成，不静默放行。
AI_SERVICE_INPUT_REVIEW_ENABLED=true
AI_SERVICE_INPUT_REVIEW_TIMEOUT_SECONDS=15
AI_SERVICE_INPUT_REVIEW_MAX_RETRIES=1
AI_SERVICE_INPUT_PROMPT_MAX_CHARS=20000
# 按供应商实际窗口配置；输入采用 UTF-8 字节上界进行保守预算检查。
AI_SERVICE_MODEL_CONTEXT_WINDOW_TOKENS=65536
AI_SERVICE_MODEL_CONTEXT_OVERHEAD_TOKENS=4096

# 第一阶段生成准备：两项独立开关；重写失败回退原文，取消和硬预算错误不降级。
AI_SERVICE_FRONTEND_SKILLS_ENABLED=true
AI_SERVICE_PROMPT_REWRITE_ENABLED=true
# always 保持现有行为；conservative 仅对完整识别的已有页面单项修改省去辅助摘要调用。
AI_SERVICE_PROMPT_REWRITE_POLICY=always
# 显式单属性编辑可省去辅助摘要；关闭后恢复正常重写，仍校验意图与原文。
AI_SERVICE_STRUCTURED_EDIT_ENABLED=true
# 只记录固定状态、原因、耗时、大小和可信规则 ID，不记录需求或摘要正文。
AI_SERVICE_PREPARATION_DIAGNOSTICS_ENABLED=true
AI_SERVICE_PROMPT_REWRITE_TIMEOUT_SECONDS=15
AI_SERVICE_PROMPT_REWRITE_MAX_TOKENS=1500
AI_SERVICE_PROMPT_REWRITE_MAX_BYTES=8192

AI_SERVICE_CHECKPOINT_ENABLED=true
AI_SERVICE_CHECKPOINT_REQUIRED=false
AI_SERVICE_CHECKPOINT_POSTGRES_URL=postgresql://yu_ai_checkpoint:replace-with-password@localhost:5432/yu_ai_checkpoint
AI_SERVICE_CHECKPOINT_AUTO_SETUP=true
AI_SERVICE_CHECKPOINT_TTL_SECONDS=86400
AI_SERVICE_CHECKPOINT_POOL_MIN_SIZE=1
AI_SERVICE_CHECKPOINT_POOL_MAX_SIZE=5
AI_SERVICE_VUE_MAX_TOOL_CALLS=40
AI_SERVICE_MAX_REPAIR_ATTEMPTS=2

# 仅用于 Vue 三角色并行审查，第一阶段默认关闭。
AI_SERVICE_MULTI_AGENT_REVIEW_ENABLED=false
# 三个 Reviewer 共享的整体超时秒数，不是每个 Reviewer 各自的超时。
AI_SERVICE_MULTI_AGENT_REVIEW_TIMEOUT_SECONDS=60

# Customer-service knowledge retrieval stays off until its providers are configured.
AI_SERVICE_CUSTOMER_SERVICE_RAG_ENABLED=false
# 权威发布默认关闭；持久启用后不能通过关掉本地开关退回旧 alias 协议。
AI_SERVICE_RAG_PUBLICATION_ENABLED=false
# 单候选序列化预算；HTTP 控制面和收据另受 64 KiB 限制。
AI_SERVICE_RAG_PUBLICATION_MAX_BYTES=67108864
# In each source, prefixed CloseAI keys take priority over legacy bare keys.
# Process environment takes priority over .env. Uncomment only when setting values.
# AI_SERVICE_CLOSEAI_API_KEY=
# AI_SERVICE_CLOSEAI_BASE_URL=
AI_SERVICE_RAG_EMBEDDING_MODEL=openai:text-embedding-3-large
AI_SERVICE_RAG_EMBEDDING_DIMENSION=3072
AI_SERVICE_RAG_EMBEDDING_BATCH_SIZE=32
AI_SERVICE_RAG_MAX_EMBEDDING_ELEMENTS=8000000
AI_SERVICE_RAG_ETL_MAX_CONCURRENCY=1
AI_SERVICE_RAG_REBUILD_MAX_DOCUMENTS=1000
AI_SERVICE_RAG_REBUILD_MAX_CHUNKS=1000000
AI_SERVICE_RAG_REBUILD_MAX_TEXT_BYTES=67108864
AI_SERVICE_MILVUS_URI=http://localhost:19530
AI_SERVICE_MILVUS_TOKEN=
AI_SERVICE_MILVUS_DATABASE=default
AI_SERVICE_MILVUS_COLLECTION_ALIAS=customer_service_knowledge
# 同请求元数据诊断默认关闭；开启后仍须 requestId 匹配非空前缀。
AI_SERVICE_RAG_DIAGNOSTICS_ENABLED=false
AI_SERVICE_RAG_DIAGNOSTICS_REQUEST_PREFIX=
AI_SERVICE_RAG_CHUNK_SIZE=1000
AI_SERVICE_RAG_CHUNK_OVERLAP=150
AI_SERVICE_RAG_RETRIEVAL_TOP_K=8
AI_SERVICE_RAG_FINAL_TOP_K=3
# 每文档最多选 1 块为默认；显式改为 2 并重启生效，改回 1 并重启即可回退。
# 每块仍占最终名额，总计最多 3 块；不调整阈值、字符或实际 JSON 字节预算。
AI_SERVICE_RAG_DOCUMENT_CHUNK_LIMIT=1
AI_SERVICE_RAG_ANSWER_TIMEOUT_SECONDS=60
# 默认 text 不发送格式参数；只有客服回答可显式启用 json_object，供应商兼容性需另行验证。
AI_SERVICE_RAG_ANSWER_RESPONSE_FORMAT=text
AI_SERVICE_RAG_PROMPT_MAX_BYTES=16384
AI_SERVICE_RAG_COLLECTION_RETENTION_GENERATIONS=2
AI_SERVICE_RAG_COLLECTION_CLEANUP_GRACE_SECONDS=120
AI_SERVICE_RAG_COLLECTION_CLEANUP_TIMEOUT_SECONDS=5
AI_SERVICE_RAG_COLLECTION_CLEANUP_SCAN_LIMIT=100
# Leave unset until a real evaluation set establishes a threshold.
# AI_SERVICE_RAG_MIN_RERANK_SCORE=
AI_SERVICE_RAG_RERANKER_PROVIDER=local_cross_encoder
AI_SERVICE_RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
AI_SERVICE_RAG_RERANKER_DEVICE=cuda
AI_SERVICE_RAG_RERANKER_TIMEOUT_SECONDS=5
AI_SERVICE_RAG_RERANKER_BATCH_SIZE=4
AI_SERVICE_RAG_RERANKER_WORKERS=1
AI_SERVICE_RAG_RERANKER_MAX_CONCURRENCY=1
# local_cross_encoder 对相同 model + device 只允许一个进程 owner；多 Web worker 请使用独立 Reranker 服务。
AI_SERVICE_RAG_OSS_ALLOWED_HOSTS=
AI_SERVICE_RAG_DOWNLOAD_MAX_BYTES=20971520
AI_SERVICE_RAG_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=5
AI_SERVICE_RAG_DOWNLOAD_READ_TIMEOUT_SECONDS=30

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=replace-with-langsmith-key
LANGSMITH_PROJECT=yu-ai-code-mother
# Optional existing LangSmith key name; Studio uses LANGSMITH_API_KEY.
# LANGGRAPH_API_KEY=replace-with-langsmith-api-key

